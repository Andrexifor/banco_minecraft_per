{
  "schemaVersion": 1,
  "id": "banco_minecraft_per",
  "version": "${version}",
  "name": "Banco Minecraft PER",
  "description": "Economía en soles para servidores Fabric: banco, billetes, monedas y bonos de reserva. Solo servidor.",
  "authors": [
    "Andrexifor"
  ],
  "contact": {
    "sources": "https://github.com/Andrexifor/banco_minecraft_per"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      {
        "value": "io.github.andrexifor.banco.BancoMinecraftPer::INSTANCE"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabricKotlin}"
  },
  "mixins": [
    "banco_minecraft_per.mixins.json"
  ]
}
